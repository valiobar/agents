# === Database ===
MONGODB_URL=mongodb://mongodb:27017
DB_NAME=agents

# === Redis ===
REDIS_URL=redis://redis:6379

# === ChromaDB ===
CHROMADB_HOST=chromadb
# Inside Docker Compose networking, services must use ChromaDB's internal port (8000).
# The host port mapping may differ (e.g. 8005:8000) for local tools, but containers should use 8000.
CHROMADB_PORT=8000

# === JWT ===
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# === Google OAuth ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Frontend / NextAuth ===
NEXT_PUBLIC_GATEWAY_URL=/gateway-api
GATEWAY_URL=http://gateway:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-development

# === LLM Providers (Phase 2+) ===
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.1
DEFAULT_AGENT_PROVIDER=openai
DEFAULT_AGENT_TYPE=accountant
DEFAULT_TEMPERATURE=0.2
MAX_HISTORY_MESSAGES=20
RAG_TOP_K=5

# === Agent Service ===
AGENT_ENV=production

# === CompanyBook.BG ===
# Optional. Accountant tools return a configuration error until the API key is set.
COMPANYBOOK_API_KEY=asdasdasd
COMPANYBOOK_BASE_URL=https://api.companybook.bg/api
COMPANYBOOK_TIMEOUT_SECONDS=10

# === Knowledge Base ===
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
CHUNK_SIZE=800
CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_BYTES=10485760
TAX_DOCS_PATH=data/knowledgebase/tax
PRELOAD_TAX_DOCS=false

# === Rate Limiting ===
RATE_LIMIT_PER_HOUR=50

# === Internal Service URLs (gateway overrides) ===
# Defaults are for Docker Compose networking. Override for custom deployments.
# AUTH_SERVICE_URL=http://auth:8001
# AGENT_SERVICE_URL=http://agent:8002
# KNOWLEDGE_SERVICE_URL=http://knowledge:8003
# ORCHESTRATOR_SERVICE_URL=http://orchestrator:8004

