# === Database ===
MONGODB_URL=mongodb://mongodb:27017
DB_NAME=agents

# === Redis ===
REDIS_URL=redis://redis:6379

# === ChromaDB ===
CHROMADB_HOST=chromadb
# Containers use ChromaDB's internal port. ChromaDB is not published on the host
# (vbar-viber-bot already binds 127.0.0.1:8000 on the shared droplet).
CHROMADB_PORT=8000

# === Images (production deploy) ===
# GitHub Actions overwrites this with the commit SHA before deploy.sh runs.
IMAGE_TAG=latest

# === JWT ===
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# === Google OAuth ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Frontend / NextAuth ===
# Browser calls use the same-origin /gateway-api rewrite. Do not point this at :8010.
NEXT_PUBLIC_GATEWAY_URL=/gateway-api
# Internal Docker DNS. Container port stays 8000; the host publish port is 8010.
GATEWAY_URL=http://gateway:8000
# Public frontend URL used by NextAuth. Compose publishes host 3010.
# Local Compose: http://localhost:3010
# Droplet:       http://159.89.26.67:3010
# `npm run dev` (frontend/.env): http://localhost:3000
NEXTAUTH_URL=http://localhost:3010
NEXTAUTH_SECRET=change-me-in-development

# Browser origins allowed to call the gateway directly (comma-separated).
# Includes npm dev (:3000), Compose host (:3010), and the droplet frontend.
CORS_ORIGINS=http://localhost:3000,http://localhost:3010,http://159.89.26.67:3010

# === LLM Providers (Phase 2+) ===
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.1
DEFAULT_AGENT_PROVIDER=openai
DEFAULT_AGENT_TYPE=accountant
DEFAULT_TEMPERATURE=0.3
MAX_HISTORY_MESSAGES=20
RAG_TOP_K=5

# === Agent Service ===
AGENT_ENV=production

# === CompanyBook.BG ===
# Optional. Accountant tools return a configuration error until the API key is set.
COMPANYBOOK_API_KEY=asdasdasd
COMPANYBOOK_BASE_URL=https://api.companybook.bg/api
COMPANYBOOK_TIMEOUT_SECONDS=10

# === Knowledge Base ===
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
CHUNK_SIZE=800
CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_BYTES=10485760
TAX_DOCS_PATH=data/knowledgebase/tax
PRELOAD_TAX_DOCS=false

# === Rate Limiting ===
RATE_LIMIT_PER_HOUR=50

# === Internal Service URLs (gateway overrides) ===
# Defaults are for Docker Compose networking. Override for custom deployments.
# AUTH_SERVICE_URL=http://auth:8001
# AGENT_SERVICE_URL=http://agent:8002
# KNOWLEDGE_SERVICE_URL=http://knowledge:8003
# ORCHESTRATOR_SERVICE_URL=http://orchestrator:8004

