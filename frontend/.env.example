# Same-origin Next.js rewrite. The browser stays on the frontend origin.
NEXT_PUBLIC_GATEWAY_URL=/gateway-api

# Server-side gateway URL for `npm run dev` against the Compose stack.
# Compose publishes the gateway on host 8010 (container port stays 8000).
# Inside Compose this is overridden to http://gateway:8000.
GATEWAY_URL=http://localhost:8010

# `npm run dev` listens on 3000. Compose publishes the frontend on host 3010.
# Droplet: http://159.89.26.67:3010
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
