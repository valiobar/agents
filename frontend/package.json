{
  "name": "agents-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "dev:host": "next dev --hostname 0.0.0.0",
    "dev:docker": "cd .. && docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build frontend gateway auth agent knowledge mongodb redis chromadb",
    "dev:docker:watch": "cd .. && docker compose -f docker-compose.yml -f docker-compose.dev.yml watch frontend gateway auth agent knowledge mongodb redis chromadb",
    "build": "next build",
    "start": "next start",
    "start:host": "next start --hostname 0.0.0.0",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "check": "npm run typecheck && npm run lint",
    "verify": "npm run check && npm run build",
    "docker:up": "cd .. && docker compose up --build frontend gateway auth agent knowledge mongodb redis chromadb",
    "docker:down": "cd .. && docker compose down",
    "docker:logs": "cd .. && docker compose logs -f frontend gateway",
    "clean": "rm -rf .next",
    "clean:install": "rm -rf .next node_modules && npm ci"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@react-pdf/renderer": "^4.5.1",
    "@tanstack/react-query": "5.59.16",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "14.2.15",
    "next-auth": "4.24.11",
    "next-themes": "0.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.53.2",
    "tailwind-merge": "2.5.5",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.23.8",
    "zustand": "5.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^2.1.9",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "jsdom": "^25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
